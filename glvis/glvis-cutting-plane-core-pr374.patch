+
+void Plane::SetPlane(double phi_, double theta_, double translation)
+{
+   phi = phi_;
+   theta = theta_;
+   rho = 1.0;
+
+   double nx = cos(phi) * cos(theta);
+   double ny = cos(phi) * sin(theta);
+   double nz = sin(phi);
+   x0 = cx + translation * nx;
+   y0 = cy + translation * ny;
+   z0 = cz + translation * nz;
+
+   SphericalToCartesian();
+}
